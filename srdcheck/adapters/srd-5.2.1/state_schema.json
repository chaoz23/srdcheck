{
 "version": "0.2",
 "doctrine": "State travels; it never resides here. Every field must be read or written by a rule atom (the minimality ratchet) — see field_atoms. The lineage field is stamped by the kernel and is not game state.",
 "field_atoms": {
  "speed": ["turn.movement-budget", "condition.grappled.speed-zero", "condition.prone.movement"],
  "conditions": ["condition.incapacitated.inactive", "condition.grappled.speed-zero", "condition.prone.movement", "condition.prone.attacks", "condition.invisible.attacks", "condition.blinded.attacks", "condition.restrained.attacks", "condition.paralyzed.attacks", "condition.stunned.attacks", "condition.grappled.attacks"],
  "exhaustion_level": ["condition.exhaustion.d20-penalty"],
  "concentration_on": ["concentration.breaks-on-incapacitated"],
  "turn.action_spent": ["turn.one-action"],
  "turn.bonus_action_spent": ["turn.one-bonus-action"],
  "turn.reaction_spent": ["turn.one-reaction-per-round"],
  "turn.free_interaction_spent": ["turn.one-free-interaction"],
  "turn.movement_ft_spent": ["turn.movement-budget", "movement.crawling-cost"],
  "turn.spell_slots_spent_this_turn": ["spell.one-slot-per-turn"],
  "hp": ["damage.reduces-hp", "hp.falling-unconscious", "hp.healing-restores", "hp.massive-damage-death", "hp.monster-death", "death-save.reset-on-heal"],
  "hp_max": ["hp.massive-damage-death", "death-save.damage-at-0"],
  "is_monster": ["hp.monster-death"],
  "resistances": ["damage.resistance-halves", "damage.order-of-application", "condition.petrified.resist-damage"],
  "immunities": ["damage.immunity-zero"],
  "vulnerabilities": ["damage.vulnerability-doubles", "damage.order-of-application"],
  "death_save_successes": ["death-save.mechanic", "death-save.natural-1-and-20", "death-save.reset-on-heal"],
  "death_save_failures": ["death-save.mechanic", "death-save.natural-1-and-20", "death-save.damage-at-0", "death-save.reset-on-heal"],
  "stable": ["death-save.mechanic"],
  "dead": ["hp.massive-damage-death", "hp.monster-death", "death-save.mechanic", "death-save.damage-at-0"]
 },
 "schema": {
  "type": "object",
  "properties": {
   "speed": {"type": "integer", "minimum": 0},
   "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
   "exhaustion_level": {"type": "integer", "minimum": 0, "maximum": 6},
   "concentration_on": {"type": ["string", "null"],
    "description": "name of the effect being concentrated on, or null"},
   "turn": {"type": "object", "properties": {
    "action_spent": {"type": "boolean"},
    "bonus_action_spent": {"type": "boolean"},
    "reaction_spent": {"type": "boolean"},
    "free_interaction_spent": {"type": "boolean"},
    "movement_ft_spent": {"type": "integer", "minimum": 0},
    "spell_slots_spent_this_turn": {"type": "integer", "minimum": 0}},
    "required": ["action_spent", "bonus_action_spent", "reaction_spent",
     "free_interaction_spent", "movement_ft_spent",
     "spell_slots_spent_this_turn"],
    "additionalProperties": false},
   "hp": {"type": "integer", "minimum": 0,
    "description": "current hit points"},
   "hp_max": {"type": "integer", "minimum": 1,
    "description": "hit point maximum"},
   "is_monster": {"type": "boolean",
    "description": "true = monster (standard damage defaults to death at 0 HP); explicit dead false records the GM's choice to use character-style unconsciousness and death saves"},
   "resistances": {"type": "array", "items": {"type": "string", "minLength": 1},
    "description": "damage types (or 'all') the creature has Resistance to — halved"},
   "immunities": {"type": "array", "items": {"type": "string", "minLength": 1},
    "description": "damage types (or 'all') the creature has Immunity to — zeroed"},
   "vulnerabilities": {"type": "array", "items": {"type": "string", "minLength": 1},
    "description": "damage types (or 'all') the creature has Vulnerability to — doubled"},
   "death_save_successes": {"type": "integer", "minimum": 0, "maximum": 3},
   "death_save_failures": {"type": "integer", "minimum": 0, "maximum": 3},
   "stable": {"type": "boolean"},
   "dead": {"type": "boolean"},
   "lineage": {"type": "object",
    "description": "kernel-stamped transition chain metadata; self commits to the game state plus every other lineage field",
    "properties": {
     "seq": {"type": "integer", "minimum": 1},
     "prev": {"type": "string", "minLength": 1,
      "description": "canonical bootstrap-state hash or the prior stamped state's lineage.self"},
     "event": {"type": "object"},
     "rule_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
     "kind": {"type": "string", "enum": ["rule", "ruling"]},
     "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256,
      "description": "stable caller event key, or a deterministic auto key when omitted"},
     "state_precondition_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "full canonical hash of the state this transition evaluated"},
     "transition_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "stable identity binding adapter, event, idempotency key, and precondition"},
     "self": {"type": "string", "minLength": 1,
      "description": "SHA-256 prefix over the canonical state plus seq, prev, event, rule_ids, and kind"}
    },
    "required": ["seq", "prev", "event", "rule_ids", "kind", "self"],
    "additionalProperties": false}
  },
  "required": ["speed", "conditions", "turn"],
  "additionalProperties": false
 }
}
